{% comment %}
  Section header component
  Props:
    id             - optional unique ID
    caption        - optional small heading text
    title          - main title (h2)
    level (string: 1, 2, 3, or 'display')
    text           - body text (plain or HTML)
    align          - alignment class, e.g. 'left', 'center'
    button_label   - label for the button
    button_url     - link for the button
    button_variant - optional variant (primary, secondary, etc.)
    button_size    - optional size (small, large)
    button_extra_classes - optional additional classes for button
{% endcomment %}

<section
  class="henk-section henk-product-block {{ alignment_class }}"
  id="section-product-{{ id | default: '1' }}"
>
  <div class="henk-section__inner">
    {% render 'henk-header-block', caption: 'test caption', level: '1', title: title %}
  </div>
</section>
