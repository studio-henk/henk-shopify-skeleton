{% comment %}
  Section header component

  header block Props:
    id             - optional unique ID
    caption        - optional small heading text
    title          - main title (h2)
    level (string: 1, 2, 3, or 'display')
    align          - alignment class, e.g. 'left', 'center'
    classes       - optional extra classes
{% endcomment %}

<section
  class="henk-section henk-product-block"
  id="section-product-{{ id | default: '1' }}"
>
  <div class="henk-section__inner">
    {% render 'henk-header-block', caption: caption, level: level, title: title, align: align, classes: classes %}

    <div class="henk-header-block__content">here</div>
  </div>
</section>
