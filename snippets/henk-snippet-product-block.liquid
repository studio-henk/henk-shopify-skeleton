{% comment %}
  Snippet product block
{% endcomment %}

<section
  class="henk-section henk-product-block"
  id="section-product-{{ id | default: '1' }}"
>
  <div class="henk-section__inner">
    {% render 'henk-header-block', caption: caption, level: level, title: title, align: align, classes: classes %}

    <div class="henk-header-block__content">
      {%
        render 'henk-snippet-media-scroller',
        blocks: blocks,
        metafield_variants: article.metafields.HENK.featured_product_variant.value | default: empty
      %}
    </div>
  </div>
</section>
