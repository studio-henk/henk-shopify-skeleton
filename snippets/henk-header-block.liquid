{% comment %}
  Inputs expected:
  - caption: string (optional)
  - title: string (required)
  - level: 'display', '1', '2', '3' (optional)
  - classes: string (optional extra classes)
{% endcomment %}

{%- assign heading_tag = 'h2' -%}
{%- assign title_class = 'henk-section-header__title' -%}

{%- case level -%}
  {%- when 'display' -%}
    {%- assign heading_tag = 'h1' -%}
    {%- assign title_class = title_class | append: ' fs-display' -%}
  {%- when '1' -%}
    {%- assign heading_tag = 'h1' -%}
  {%- when '3' -%}
    {%- assign heading_tag = 'h3' -%}
  {%- else -%}
    {%- assign heading_tag = 'h2' -%}
{%- endcase -%}

<header class="henk-section-header {{ classes }}">
  {%- if caption != blank -%}
    <p class="henk-section-header__caption">{{ caption }}</p>
  {%- endif -%}

  {%- if title != blank -%}
    <{{ heading_tag }} class="{{ title_class }}">{{ title }}</{{ heading_tag }}>
  {%- endif -%}
</header>
