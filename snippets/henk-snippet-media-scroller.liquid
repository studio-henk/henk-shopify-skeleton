{% comment %}
  Fake products array for development
{% endcomment %}
{% assign products = "[{'title':'Product 1','url':'#','image':'/path/to/img1.jpg'},
    {'title':'Product 2','url':'#','image':'/path/to/img2.jpg'},
    {'title':'Product 3','url':'#','image':'/path/to/img3.jpg'}]" %}
<div class="media-scroller-container">
  <div class="media-scroller snaps-inline">
    <div class="media-element">
      {% render 'henk-card',
        product: product.products[0],
        variant: first_variant,
        collection: collection,
        card_variant: 'macs',
        show_variants_on_card: show_variants_on_card
      %}
    </div>

    <div class="media-element">card</div>

    <div class="media-element">card</div>
  </div>
</div>
<style>
  .snaps-inline {
    scroll-padding-inline: 0;
    scroll-snap-type: inline mandatory;
  }

  .media-scroller {
    display: grid;
    gap: 1rem;
    /* grid-auto-columns: 41%; */
    grid-auto-columns: 84%;
    grid-auto-flow: column;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 1rem 0;
  }

  .snaps-inline > * {
    scroll-snap-align: start;
  }

  .media-element {
    background-color: var(--color-background-muted, grey);
    border-radius: 8px;
    grid-template-rows: auto;
    aspect-ratio: 2 / 3;
  }

  .media-element,
  .media-group {
    display: grid;
    gap: 1rem;
  }

  .media-scroller::-webkit-scrollbar {
    height: 24px;
  }

  .media-scroller::-webkit-scrollbar-track {
    background-color: var(--color-background-secondary, lightgrey);
    border-radius: 100vw;
  }

  .media-scroller::-webkit-scrollbar-thumb {
    background-color: var(--color-primary, blue);
    border-radius: 100vw;
  }

  .media-scroller-container {
    container-type: inline-size;
  }

  /* breakpoint = (min-card-width × desired-cards) + (gap × (desired-cards - 1)) */
  @container (min-width: 718px) {
    .media-scroller {
      grid-auto-flow: row;
      /* grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); */
      grid-template-columns: repeat(auto-fill, minmax(327px, 1fr));
      overflow-x: visible;
      scroll-snap-type: none;
    }

    .media-scroller > * {
      scroll-snap-align: none;
    }
  }
</style>
